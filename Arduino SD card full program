#include "RTClib.h" 
#include <SPI.h> 
#include <SD.h> 
//RTC needs to be set up here for use in 'setup' and 'loop', line 6 based on Rui Santos, https://RandomNerdTutorials.com/arduino-ds3231-real-time-clock/
RTC_DS3231 rtc;
char daysOfTheWeek[7][12] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
String fileName;
unsigned long startMillis;
int startHour;
int startMinute;
int startSecond;


void setup () { 
  Serial.begin(9600);
  
  //RTC code in lines 18-31 based on Rui Santos, https://RandomNerdTutorials.com/arduino-ds3231-real-time-clock/ 
  if (! rtc.begin()) { 
    Serial.println("Couldn't find RTC");
    Serial.flush();
    while (1) delay(10);
    } 
    
  if (rtc.lostPower()) { 
    Serial.println("RTC lost power, let's set the time!");
      // When time needs to be set on a new device, or after a power loss, the // following line sets the RTC to the date & time this sketch was compiled 
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
      // This line sets the RTC with an explicit date & time, for example to set
      // January 21, 2014 at 3am you would call:
      //rtc.adjust(DateTime(2014, 1, 21, 3, 0, 0)); 
    } 
      
  const int SD_chipSelect = 10;

  //Basic error detection
  if (!SD.begin(SD_chipSelect)) { 
    Serial.println("SD initialization failed"); 
    while (true);  
  } else{
    Serial.println("SD initialization success!");
  }

  //RTC code on lines 44-56 based on Rui Santos, https://RandomNerdTutorials.com/arduino-ds3231-real-time-clock/
  DateTime now = rtc.now(); 
    // Getting each time field in individual variables 
    // And adding a leading zero when needed; 
  String yearStr = String(now.year(), DEC); 
  String monthStr = (now.month() < 10 ? "0" : "") + String(now.month(), DEC); 
  String dayStr = (now.day() < 10 ? "0" : "") + String(now.day(), DEC); 
  String hourStr = (now.hour() < 10 ? "0" : "") + String(now.hour(), DEC); 
  String minuteStr = (now.minute() < 10 ? "0" : "") + String(now.minute(), DEC); 
  String secondStr = (now.second() < 10 ? "0" : "") + String(now.second(), DEC); 
  String dayOfWeek = daysOfTheWeek[now.dayOfTheWeek()];
 

  String formattedTime = dayOfWeek + ", " + yearStr + "-" + monthStr + "-" + dayStr + " " + hourStr + ":" + minuteStr + ":" + secondStr;

  fileName = dayStr + hourStr + minuteStr + secondStr + ".txt";


  //logs the starting time so that new timestamps are relative to one initial RTC call
  startHour = now.hour();
  startMinute = now.minute();
  startSecond = now.second();

  startMillis = millis();

  File dataFile = SD.open(fileName.c_str(), FILE_WRITE);

  dataFile.print("Sampling occurring on: ");
  dataFile.println(formattedTime);

  dataFile.close();

}   
   
void loop () { 
    
  float x = 0;
  float y = 0;
  float runningTotal = 0;
  float currentVal = 0;
  float count = 0;
  int n = 1;
  float r = 0;
  float f = 0;

  //Line 89 generated by AI as I struggled to find resources online for this feature
  File dataFile = SD.open(fileName.c_str(), FILE_WRITE);
  //Original line, predetermined file name:
  //File dataFile = SD.open("data1.txt", FILE_WRITE);

  if (!dataFile) { 
    Serial.println("file open error"); 
    while(true);
  } else{
    Serial.println("file opened successfully!");
  }

  //Calculates average sensor value for first 5 seconds
  Serial.println("calibrating");

  while(millis() <= 5000){

    currentVal = (10.850 * analogRead(A0)) / 1023;
    runningTotal = runningTotal + currentVal;
    count = count + 1.000;
    delay(100);

  }
  
  float normal = runningTotal / (count);

  if(n >= 1){
    n--;
    
    Serial.println("finished");
    Serial.print("running total = ");
    Serial.println(runningTotal, 3);
    Serial.print("count = ");
    Serial.println(count, 3);
    Serial.print("norm = ");
    Serial.println(normal, 3);
    
    dataFile.print("running total = ");
    dataFile.println(runningTotal, 3);
    dataFile.print("count = ");
    dataFile.println(count, 3);
    dataFile.print("norm = ");
    dataFile.println(normal, 3);

    dataFile.println("data follows");

    delay(1000);
  }


  Serial.println("data writing to SD card");

  f = analogRead(A0);


  while(true){

    unsigned long prevMillis = 0;

    unsigned long nowMillis = millis();
    if(nowMillis - prevMillis >=10){
      prevMillis = nowMillis;

      int raw = analogRead(A0);

      //basic
      x = 5.000 * (raw) / 1023;
      float travel = normal - (2.17 * x);

      //deadband infill section - AI helped debug the original code which was not working
      int deadband = 1;
      static int prev = analogRead(A0); 
      float filtered = 0;

      int delta = raw - prev;

      if (abs(delta) <= deadband) { // check if jump is within deadband
        filtered = prev; // ignore small jitter
      }
      else if (abs(delta) == 2) {     // infill middle value
        filtered = prev + (delta / 2); // check sign
      }
      else {
        filtered = raw;  // big jump, accept full change
      }
      prev = filtered;

      float x1 = 5.000 * (filtered) / 1023;
      float travel1 = normal - (2.17 * x1);

      //exponential smoothing
      float smoothing = 0.8; //smaller = more smoothing
      f = smoothing * filtered + (1 - smoothing) * f;

      //fix asymptotoic convergence issue
      if (abs(f - filtered) < 0.5) {
        f = filtered;
      }
    
      //send unfiltered data for comparison
      float x2 = 5.000 * (f) / 1023;
      float travel2 = normal - (2.17 * x2);

      //calculate time based on initial RTC call
      unsigned long elapsedMillis = millis() - startMillis;

      unsigned long totalSeconds = elapsedMillis / 1000;
      unsigned int ms = elapsedMillis % 1000;

      int sec = startSecond + totalSeconds;
      int min = startMinute + sec / 60;
      int hr = startHour + min / 60;

      sec = sec % 60;
      min = min % 60;
      hr = hr % 24;


      if(dataFile){
        
        if(hr < 10){
          dataFile.println("0");
        }
        dataFile.print(hr);
        dataFile.print(":");
        if(min < 10){
          dataFile.print("0");
        }
        dataFile.print(min);
        dataFile.print(":");
        if(sec < 10){
          dataFile.print("0");
        }
        dataFile.print(sec);
        dataFile.print(".");
        if(ms < 100){
          dataFile.print("0");
        }
        if(ms < 10){
          dataFile.print("0");
        }
        dataFile.print(ms);
        dataFile.print(", ");

        dataFile.print(travel, 3);
        dataFile.print(", ");

        //dataFile.print(travel1, 3);
        //dataFile.print(",");

        dataFile.println(travel2, 3);
        //dataFile.print(", ");

        if(nowMillis % 1000 < 10){
          dataFile.flush();
        }

      } else{
        Serial.println("file error");
      }

      
    }
  }
}
    


